{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/hira/(.*)",
      "dest": "https://apis.data.go.kr/B551182/$1"
    },
    {
      "src": "/api/tour/(.*)",
      "dest": "https://apis.data.go.kr/B551011/$1"
    },
    {
      "src": "/api/weather/(.*)",
      "dest": "https://apis.data.go.kr/1360000/$1"
    },
    {
      "src": "/api/housing/(.*)",
      "dest": "https://apis.data.go.kr/1613000/$1"
    },
    {
      "src": "/api/pharmacy/(.*)",
      "dest": "https://apis.data.go.kr/B552657/$1"
    },
    {
      "src": "/api/standard/(.*)",
      "dest": "https://api.data.go.kr/openapi/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/icons.svg",
      "dest": "/icons.svg"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
