{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/hira/(.*)",
      "dest": "https://apis.data.go.kr/B551182/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/api/tour/(.*)",
      "dest": "https://apis.data.go.kr/B551011/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/api/weather/(.*)",
      "dest": "https://apis.data.go.kr/1360000/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/api/housing/(.*)",
      "dest": "https://apis.data.go.kr/1613000/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/api/pharmacy/(.*)",
      "dest": "https://apis.data.go.kr/B552657/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/api/standard/(.*)",
      "dest": "https://api.data.go.kr/openapi/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "^/(?!api/).*",
      "dest": "/index.html"
    }
  ]
}
