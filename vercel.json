{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/hira/:path*", "destination": "https://apis.data.go.kr/B551182/:path*" },
    { "source": "/api/tour/:path*", "destination": "https://apis.data.go.kr/B551011/:path*" },
    { "source": "/api/weather/:path*", "destination": "https://apis.data.go.kr/1360000/:path*" },
    { "source": "/api/housing/:path*", "destination": "https://apis.data.go.kr/1613000/:path*" },
    { "source": "/api/pharmacy/:path*", "destination": "https://apis.data.go.kr/B552657/:path*" },
    { "source": "/api/standard/:path*", "destination": "https://api.data.go.kr/openapi/:path*" }
  ]
}
